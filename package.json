{
  "name": "semar",
  "version": "2.1.0",
  "description": "Semar - Self-hosted lyrics database with node isolation, PostgreSQL/MySQL/SQLite support, SemAPI dynamic routes, and YouTube Video ID caching.",
  "type": "module",
  "main": "src/server/index.ts",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build:client": "vite build --config src/client/vite.config.ts",
    "build": "npm run build:client",
    "start": "tsx src/server/index.ts",
    "seed": "tsx src/server/db/seed.ts",
    "test": "node --import tsx --test test/semar.test.ts test/semar-v21.test.ts"
  },
  "keywords": [
    "semar",
    "lyrics",
    "lyrics-database",
    "postgresql",
    "mysql",
    "sqlite",
    "semapi",
    "youtube-cache",
    "node-isolation",
    "vue3",
    "express"
  ],
  "author": "orekiServices",
  "license": "MIT",
  "dependencies": {
    "@uimaxbai/am-lyrics": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.0.2",
    "lucide-vue-next": "^1.0.0",
    "mysql2": "^3.12.0",
    "pg": "^8.13.1",
    "pinia": "^3.0.1",
    "uuid": "^11.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
